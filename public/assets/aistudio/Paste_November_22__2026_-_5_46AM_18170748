ue.textContent \x3d RETENTION_LABELS\x5bNumber(retentionSlider.value)\x5d;\\n    \x7d);\\n\\n    function showStatus(message, kind) \x7b\\n      status.textContent \x3d message;\\n      status.className \x3d \x27status\x27 + (kind ? \x27 \x27 + kind : \x27\x27);\\n    \x7d\\n\\n    function setUploadProgress(value, label) \x7b\\n      const percent \x3d Math.max(0, Math.min(100, Math.round(value)));\\n      uploadProgressFill.style.width \x3d percent + \x27%\x27;\\n      uploadProgress.setAttribute(\x27aria-valuenow\x27, String(percent));\\n      uploadProgressLabel.textContent \x3d label || percent + \x27%\x27;\\n    \x7d\\n\\n    function formatSize(size) \x7b\\n      return size \x3c 1024 * 1024\\n        ? (size \/ 1024).toFixed(1) + \x27 KB\x27\\n        : (size \/ (1024 * 1024)).toFixed(2) + \x27 MB\x27;\\n    \x7d\\n\\n    function chooseFile(file) \x7b\\n      if (!file) return;\\n      if (busy) \x7b\\n        showStatus(\x27アップロード中は別のファイルを選択できません。\x27, \x27error\x27);\\n        return;\\n      \x7d\\n      if (file.size \x3e MAX_SIZE) \x7b\\n        selectedFile \x3d null;\\n        dropZone.classList.remove(\x27has-file\x27);\\n        document.getElementById(\x27zoneTitle\x27).textContent \x3d \x27ファイルをここにドロップ\x27;\\n        document.getElementById(\x27zoneHint\x27).textContent \x3d \x27またはファイルを選択してください\x27;\\n        chooseButton.textContent \x3d \x27ファイルを選択\x27;\\n        selectionPanel.hidden \x3d false;\\n        resultPanel.hidden \x3d true;\\n        uploadButton.hidden \x3d true;\\n        showStatus(\x27ファイルサイズは50 MiB以下にしてください。\x27, \x27error\x27);\\n        return;\\n      \x7d\\n      selectedFile \x3d file;\\n      status.hidden \x3d false;\\n      selectionPanel.hidden \x3d false;\\n      resultPanel.hidden \x3d true;\\n      dropZone.classList.add(\x27has-file\x27);\\n      document.getElementById(\x27zoneTitle\x27).textContent \x3d file.name;\\n      document.getElementById(\x27zoneHint\x27).textContent \x3d formatSize(file.size);\\n      chooseButton.textContent \x3d \x27ほかのファイルに変更\x27;\\n      uploadButton.hidden \x3d false;\\n      uploadButton.disabled \x3d busy;\\n      showStatus(\x27\x27, \x27\x27);\\n    \x7d\\n\\n    function openFilePicker() \x7b\\n      if (busy) return;\\n      fileInput.value \x3d \x27\x27;\\n      fileInput.click();\\n    \x7d\\n\\n    function bytesToBase64(bytes) \x7b\\n      let binary \x3d \x27\x27;\\n      for (let start \x3d 0; start \x3c bytes.length; start +\x3d 0x8000) \x7b\\n        const end \x3d Math.min(start + 0x8000, bytes.length);\\n        for (let i \x3d start; i \x3c end; i++) binary +\x3d String.fromCharCode(bytes\x5bi\x5d);\\n      \x7d\\n      return btoa(binary);\\n    \x7d\\n\\n    function callServer(method, ...args) \x7b\\n      return new Promise((resolve, reject) \x3d\x3e \x7b\\n        google.script.run\\n          .withSuccessHandler(resolve)\\n          .withFailureHandler(error \x3d\x3e reject(new Error(error \x26\x26 error.message ? error.message : \x27サーバーとの通信に失敗しました。\x27)))\\n          \x5bmethod\x5d(...args);\\n      \x7d);\\n    \x7d\\n\\n    async function upload() \x7b\\n      if (!selectedFile || busy) return;\\n      const file \x3d selectedFile;\\n      busy \x3d true;\\n      uploadButton.hidden \x3d true;\\n      uploadProgress.hidden \x3d false;\\n      setUploadProgress(0, \x27準備中\\u2026\x27);\\n      chooseButton.disabled \x3d true;\\n      chooseButton.hidden \x3d true;\\n      retentionSlider.disabled \x3d true;\\n      document.getElementById(\x27retentionControls\x27).hidden \x3d true;\\n      status.hidden \x3d true;\\n      document.getElementById(\x27resultPanel\x27).hidden \x3d true;\\n      let uploadId \x3d null;\\n      try \x7b\\n        const started \x3d await callServer(\x27beginUpload\x27, \x7b\\n          fileName: file.name,\\n          mimeType: file.type || \x27application\/octet-stream\x27,\\n          fileSize: file.size,\\n          retentionMinutes: RETENTION_OPTIONS\x5bNumber(retentionSlider.value)\x