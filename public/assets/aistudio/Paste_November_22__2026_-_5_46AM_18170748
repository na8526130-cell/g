   retentionSlider.disabled \x3d false;\\n        allowExtension.disabled \x3d false;\\n        document.getElementById(\x27retentionControls\x27).hidden \x3d !resultPanel.hidden;\\n      \x7d\\n    \x7d\\n\\n    chooseButton.addEventListener(\x27click\x27, openFilePicker);\\n    dropZone.addEventListener(\x27click\x27, event \x3d\x3e \x7b\\n      if (!selectionPanel.hidden \x26\x26 event.target !\x3d\x3d chooseButton) openFilePicker();\\n    \x7d);\\n    dropZone.addEventListener(\x27keydown\x27, event \x3d\x3e \x7b\\n      if (!selectionPanel.hidden \x26\x26 (event.key \x3d\x3d\x3d \x27Enter\x27 || event.key \x3d\x3d\x3d \x27 \x27) \x26\x26 event.target \x3d\x3d\x3d dropZone) \x7b\\n        event.preventDefault();\\n        openFilePicker();\\n      \x7d\\n    \x7d);\\n    fileInput.addEventListener(\x27change\x27, () \x3d\x3e chooseFile(fileInput.files \x26\x26 fileInput.files\x5b0\x5d));\\n    \x5b\x27dragenter\x27, \x27dragover\x27\x5d.forEach(name \x3d\x3e dropZone.addEventListener(name, event \x3d\x3e \x7b\\n      event.preventDefault();\\n      if (!busy \x26\x26 resultPanel.hidden) dropZone.classList.add(\x27is-over\x27);\\n    \x7d));\\n    \x5b\x27dragleave\x27, \x27drop\x27\x5d.forEach(name \x3d\x3e dropZone.addEventListener(name, event \x3d\x3e \x7b\\n      event.preventDefault();\\n      dropZone.classList.remove(\x27is-over\x27);\\n    \x7d));\\n    dropZone.addEventListener(\x27drop\x27, event \x3d\x3e \x7b\\n      if (busy || !resultPanel.hidden) return;\\n      const files \x3d event.dataTransfer \x26\x26 event.dataTransfer.files;\\n      if (!files || files.length !\x3d\x3d 1) \x7b\\n        showStatus(\x27一度に選択できるファイルは1つだけです。\x27, \x27error\x27);\\n        return;\\n      \x7d\\n      chooseFile(files\x5b0\x5d);\\n    \x7d);\\n    uploadButton.addEventListener(\x27click\x27, upload);\\n    document.getElementById(\x27copyButton\x27).addEventListener(\x27click\x27, async () \x3d\x3e \x7b\\n      const field \x3d document.getElementById(\x27shareUrl\x27);\\n      try \x7b\\n        await navigator.clipboard.writeText(field.value);\\n        document.getElementById(\x27resultFeedback\x27).textContent \x3d \x27共有URLをコピーしました。\x27;\\n      \x7d catch (error) \x7b\\n        field.focus();\\n        field.select();\\n        const copied \x3d document.execCommand(\x27copy\x27);\\n        document.getElementById(\x27resultFeedback\x27).textContent \x3d copied\\n          ? \x27共有URLをコピーしました。\x27\\n          : \x27URLを選択しました。コピーしてください。\x27;\\n      \x7d\\n    \x7d);\\n    document.getElementById(\x27resetButton\x27).addEventListener(\x27click\x27, () \x3d\x3e \x7b\\n      selectedFile \x3d null;\\n      fileInput.value \x3d \x27\x27;\\n      document.getElementById(\x27resultFeedback\x27).textContent \x3d \x27\x27;\\n      selectionPanel.hidden \x3d false;\\n      resultPanel.hidden \x3d true;\\n      document.getElementById(\x27retentionControls\x27).hidden \x3d false;\\n      document.getElementById(\x27uploadActions\x27).hidden \x3d false;\\n      dropZone.classList.remove(\x27has-file\x27);\\n      document.getElementById(\x27zoneTitle\x27).textContent \x3d \x27ファイルをここにドロップ\x27;\\n      document.getElementById(\x27zoneHint\x27).textContent \x3d \x27またはファイルを選択してください\x27;\\n      chooseButton.textContent \x3d \x27ファイルを選択\x27;\\n      uploadButton.hidden \x3d true;\\n      uploadButton.disabled \x3d true;\\n      uploadProgress.hidden \x3d true;\\n      setUploadProgress(0, \x27準備中\\u2026\x27);\\n      status.hidden \x3d false;\\n      showStatus(\x27\x27, \x27\x27);\\n    \x7d);\\n  \x3c\\\/script\x3e\\n\x3c\\\/body\x3e\\n\x3c\\\/html\x3e\\n\x22,\x22ncc\x22:\x22\x7b\\\x22awhs\\\x22:true\x7d\x22\x7d", "", undefined, true , false  , "false", "https:\/\/n-2vthzhmuqbzfxei3t3ml2n2gqa5fbrl4gqfxcvi-0lu-script.googleusercontent.com", "https:\/\/drive.google.com\/abuse?id\x3dAFS7AdvnEX25n3Go7WYRcVNH-6tDkcTUHgFHBXuvii3w3PdSqyrC1QsZ3tmsMQ8U0fIKqqOSYvf4ukXo0C68FnCe1kI9uO7AANs0NYUX%3A0\x26docurl\x3dhttps%3A%2F%2Fscript.google.c