{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{data/**,public/assets/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|manifest\\.webmanifest|sw\\.js|workbox-.*|registerSW\\.js|favicon\\.ico|icon\\.svg|apple-touch-icon\\.png|pwa-.*).*)",
      "destination": "/index.html"
    }
  ]
}
